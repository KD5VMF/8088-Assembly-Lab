@ECHO OFF
REM Build GALMATH16.COM with Borland Turbo Assembler and TLINK.
REM Requires TASM.EXE and TLINK.EXE to be in PATH or in this directory.

IF EXIST GALMATH16.OBJ DEL GALMATH16.OBJ
IF EXIST GALMATH16.COM DEL GALMATH16.COM
IF EXIST GALMATH16.MAP DEL GALMATH16.MAP

TASM GALMATH16.ASM
IF ERRORLEVEL 1 GOTO FAIL

TLINK /T GALMATH16.OBJ
IF ERRORLEVEL 1 GOTO FAIL

ECHO.
ECHO Build complete: GALMATH16.COM
GOTO END

:FAIL
ECHO.
ECHO Build failed. Check TASM/TLINK error messages above.

:END
